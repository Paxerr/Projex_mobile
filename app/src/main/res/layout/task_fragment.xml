<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/to"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/home_bg_main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:paddingLeft="4dp"
            android:text="Task"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="8dp"
                    android:orientation="vertical">

                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingLeft="4dp"
                        android:text="Quản lý hiệu quả các nhiệm vụ cá nhân"
                        android:textColor="#ABABAB"
                        android:textSize="16sp"
                        android:layout_marginBottom="16dp"/>

                    <include
                        android:id="@+id/searchBar"
                        layout="@layout/layout_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        />
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <LinearLayout
                                android:id="@+id/btnAllTask"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/pro_background"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="16dp"
                                android:layout_marginEnd="12dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="7dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_alltask"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="All Tasks"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btnStatus"
                                android:layout_width="127dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"
                                android:background="@drawable/pro_background"
                                android:clickable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="26dp"
                                android:paddingVertical="12dp">

                                <TextView
                                    android:id="@+id/textStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="Trạng thái"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp" />

                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_drop" />
                            </LinearLayout>

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTask"
                    android:layout_marginHorizontal="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>



        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/paginationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPrevPage"
            android:layout_width="86dp"
            android:layout_height="40dp"
            android:background="@drawable/pro_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Truoc"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Trang 1"
            android:textColor="#ABABAB"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNextPage"
            android:layout_width="86dp"
            android:layout_height="40dp"
            android:background="@drawable/pro_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Sau"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
