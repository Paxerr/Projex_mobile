<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Popup content. DialogFragment sẽ tự tạo phần nền mờ phía sau. -->
    <FrameLayout
        android:id="@+id/modalOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/modalCard"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="@drawable/home_bg_main"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Header: X - Title - Gửi -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp">

                <ImageView

                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:contentDescription="Đóng"
                    android:focusable="true"
                     />

                <TextView
                    android:id="@+id/tvModalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Thêm thành viên"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Label + Input: Tên hoặc email -->
            <TextView
                android:id="@+id/tvLabelEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tên hoặc email"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmailOrName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/team_bg_card"
                android:hint="Ví dụ: name@company.com"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#F3F6FA"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp"
                 />

            <!-- Label: SELECT ROLE -->
            <TextView
                android:id="@+id/tvLabelRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="SELECT ROLE"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Dropdown thuần: TextView + PopupMenu -->
            <RelativeLayout
                android:id="@+id/roleBox"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/team_bg_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Member"
                    android:textColor="#F3F6FA"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/icRoleChevron"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Mở danh sách"
                    android:src="@drawable/ic_chevron_down" />
            </RelativeLayout>

            <!-- Footer: Hủy + Thêm -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="Hủy"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAdd"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Thêm"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </RelativeLayout>

        </LinearLayout>
    </FrameLayout>

</FrameLayout>
