<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/home_bg_main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnHuy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="20dp"
            android:clickable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="24sp"
            android:gravity="center"
            android:text="Chi tiết"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lưu"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="20dp"
            android:clickable="true"
            />
    </LinearLayout>
    <ScrollView

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/r4i8c6o0aiki"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp">

                    <!-- GGshop -->
                    <LinearLayout

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/team_bg_card"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="12dp">


                        <TextView
                            android:id="@+id/txtProject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GGshop"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp"/>


                    </LinearLayout>

                    <!-- Task -->
                    <LinearLayout
                        android:id="@+id/btnStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/team_bg_card"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="16dp"
                        >



                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp"/>

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_drop"
                            />

                    </LinearLayout>

                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="TÊN TASK"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="20dp"/>
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/team_bg_card"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:elevation="24dp"
                    android:gravity="center_vertical">


                    <EditText
                        android:id="@+id/taskname"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Tên task"
                        android:textColorHint="#FFFFFF"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        />


                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="MÔ TẢ"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="20dp"/>
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/team_bg_card"
                    android:padding="8dp"

                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:elevation="24dp">

                    <EditText
                        android:id="@+id/description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Mô tả"
                        android:textColorHint="#FFFFFF"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"/>


                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="THỜI HẠN"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="20dp"/>
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/team_bg_card"
                    android:padding="8dp"

                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:elevation="24dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/Duedate"
                        android:textColorHint="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:hint="Thời hạn"
                        android:layout_weight="1"
                        android:textColor="#FFFFFF"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"/>

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="THỜI GIAN BẮT ĐẦU"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="20dp"/>
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/team_bg_card"
                    android:padding="8dp"

                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:elevation="24dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/Startdate"
                        android:textColorHint="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:hint="Thời gian bắt đầu"
                        android:layout_weight="1"
                        android:textColor="#FFFFFF"
                        android:clickable="false"
                        android:editable="false"/>

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="MỨC ĐỘ ƯU TIÊN (1 - 3)"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="20dp"/>
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/team_bg_card"
                    android:padding="8dp"

                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:elevation="24dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/Priority"
                        android:textColorHint="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:hint="mức độ ưu tiên"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="PHÂN CÔNG"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="20dp"/>
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/team_bg_card"
                    android:padding="8dp"

                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="20dp"
                    android:elevation="24dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/Assigned"
                        android:textColorHint="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:hint="Phân công cho"
                        android:layout_weight="1"
                        android:textColor="#FFFFFF"
                        />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnDeleteTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/team_bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Xóa Task"
                    android:textColor="#FF4D4D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
