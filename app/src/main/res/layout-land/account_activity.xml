<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAccount"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".AccountActivity"
    tools:deviceWidth="803dp"
    tools:deviceHeight="390dp">

    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="10dp"
        android:text="Trang tài khoản"
        android:textColor="#57A7FF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvScreenTitle">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineStatsStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.46" />

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_account_btn_round_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Back"
                app:srcCompat="@drawable/ic_back"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tài khoản"
            android:textColor="#B9BDC8"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintEnd_toStartOf="@+id/guidelineStatsStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btnBack" />

        <FrameLayout
            android:id="@+id/btnEditProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_account_btn_round_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintEnd_toStartOf="@+id/guidelineStatsStart"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Edit profile"
                app:srcCompat="@drawable/account_ic_edit"
                app:tint="#4A8CFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/cardAvatar"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_account_avatar_land"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnBack">

            <TextView
                android:id="@+id/tvAvatarText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="TD"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <View
            android:id="@+id/viewOnlineDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/account_online_dot"
            app:layout_constraintBottom_toBottomOf="@+id/cardAvatar"
            app:layout_constraintEnd_toEndOf="@+id/cardAvatar" />

        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="18dp"
            android:text="Tiến Đạt Đinh"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tvEmail"
            app:layout_constraintEnd_toStartOf="@+id/guidelineStatsStart"
            app:layout_constraintStart_toEndOf="@+id/cardAvatar"
            app:layout_constraintTop_toTopOf="@+id/cardAvatar"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="18dp"
            android:text="dinhtiendat2105@gmail.com"
            android:textColor="#8C909A"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/cardAvatar"
            app:layout_constraintEnd_toStartOf="@+id/guidelineStatsStart"
            app:layout_constraintStart_toEndOf="@+id/cardAvatar"
            app:layout_constraintTop_toBottomOf="@+id/tvFullName" />

        <LinearLayout
            android:id="@+id/cardTasks"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_account_stat_land"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/cardProjects"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardAvatar"
            app:layout_constraintWidth_percent="0.14">

            <TextView
                android:id="@+id/tvTasksValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="TASKS"
                android:textColor="#6E778A"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardProjects"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_account_stat_land"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/cardTasks"
            app:layout_constraintEnd_toStartOf="@+id/cardOnTime"
            app:layout_constraintStart_toEndOf="@+id/cardTasks"
            app:layout_constraintTop_toTopOf="@+id/cardTasks"
            app:layout_constraintWidth_percent="0.14">

            <TextView
                android:id="@+id/tvProjectsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="PROJECTS"
                android:textColor="#6E778A"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardOnTime"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_account_stat_land"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/cardTasks"
            app:layout_constraintEnd_toStartOf="@+id/guidelineStatsStart"
            app:layout_constraintStart_toEndOf="@+id/cardProjects"
            app:layout_constraintTop_toTopOf="@+id/cardTasks"
            app:layout_constraintWidth_percent="0.14">

            <TextView
                android:id="@+id/tvOnTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="98%"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="ON TIME"
                android:textColor="#6E778A"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSystemSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:letterSpacing="0.25"
            android:text="CÀI ĐẶT HỆ THỐNG"
            android:textColor="#7E8798"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/guidelineStatsStart"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardNotifications"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_account_setting_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guidelineStatsStart"
            app:layout_constraintTop_toBottomOf="@+id/tvSystemSettings">

            <FrameLayout
                android:id="@+id/iconBellCard"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_account_icon_blue_land"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notification"
                    app:srcCompat="@drawable/account_ic_nofication"
                    app:tint="#4A8CFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNotificationText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Thông báo đẩy"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/iconBellCard"
                app:layout_constraintEnd_toStartOf="@+id/switchNotifications"
                app:layout_constraintStart_toEndOf="@+id/iconBellCard"
                app:layout_constraintTop_toTopOf="@+id/iconBellCard" />

            <Switch
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:checked="true"
                app:layout_constraintBottom_toBottomOf="@+id/iconBellCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iconBellCard" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardChangePassword"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_account_setting_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guidelineStatsStart"
            app:layout_constraintTop_toBottomOf="@+id/cardNotifications">

            <FrameLayout
                android:id="@+id/iconLockCard"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_account_icon_dark_land"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Lock"
                    app:srcCompat="@drawable/login_ic_lock"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvChangePassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Đổi mật khẩu"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/iconLockCard"
                app:layout_constraintEnd_toStartOf="@+id/icChevronRight"
                app:layout_constraintStart_toEndOf="@+id/iconLockCard"
                app:layout_constraintTop_toTopOf="@+id/iconLockCard" />

            <TextView
                android:id="@+id/icChevronRight"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#687085"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/iconLockCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iconLockCard" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardLogout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="22dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_account_logout_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guidelineStatsStart"
            app:layout_constraintTop_toBottomOf="@+id/cardChangePassword">

            <FrameLayout
                android:id="@+id/iconLogoutCard"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_account_icon_red_land"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logout"
                    app:srcCompat="@drawable/account_logout"
                    app:tint="#FF4D4D" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLogout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="ĐĂNG XUẤT"
                android:textColor="#FF4D4D"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/iconLogoutCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iconLogoutCard"
                app:layout_constraintTop_toTopOf="@+id/iconLogoutCard" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_account_bottom_nav_land"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/bottomHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_account_bottom_item_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Home"
                app:srcCompat="@drawable/account_ic_home"
                app:tint="#8A909B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="HOME"
                android:textColor="#8A909B"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomSpaces"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_account_bottom_item_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Spaces"
                app:srcCompat="@drawable/ic_space"
                app:tint="#8A909B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SPACES"
                android:textColor="#8A909B"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomTasks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_account_bottom_item_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Tasks"
                app:srcCompat="@drawable/ic_task"
                app:tint="#8A909B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TASKS"
                android:textColor="#8A909B"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomNotification"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_account_bottom_item_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Notification"
                app:srcCompat="@drawable/ic_nofication"
                app:tint="#8A909B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="NOTIFICATION"
                android:textColor="#8A909B"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomUser"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_account_bottom_selected_land"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="User"
                app:srcCompat="@drawable/ic_avatar"
                app:tint="#8CB2FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="USER"
                android:textColor="#8CB2FF"
                android:textSize="8sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
