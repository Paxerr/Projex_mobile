<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Auth"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/authContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="40dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.44" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/formPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideColumn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/logoRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/login_logo_pj_rm_bg" />

                <TextView
                    android:id="@+id/txtRo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RO"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtJex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JEX"
                    android:textColor="#3B82F6"
                    android:textSize="34sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Chào mừng trở lại!"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/logoRow" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Đăng nhập hoặc đăng ký để quản lý các dự án của bạn."
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtWelcome" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/authCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_min="340dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtDescription">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/login_input_view"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:background="@android:color/transparent"
                    android:backgroundTint="@null"
                    android:elevation="0dp"
                    android:padding="4dp"

                    app:layout_constraintEnd_toEndOf="@id/viewPager"
                    app:layout_constraintStart_toStartOf="@id/viewPager"
                    app:layout_constraintTop_toTopOf="@id/viewPager"

                    app:tabMode="scrollable"
                    app:tabGravity="center"
                    app:tabMinWidth="0dp"
                    app:tabMaxWidth="0dp"
                    app:tabPaddingStart="24dp"
                    app:tabPaddingEnd="24dp"

                    app:tabIndicator="@android:color/transparent"
                    app:tabIndicatorHeight="0dp"
                    app:tabIndicatorAnimationDuration="0"
                    app:tabRippleColor="@android:color/transparent"

                    app:tabSelectedTextColor="#000000"
                    app:tabTextAppearance="@style/Custom_login_tab"
                    app:tabTextColor="#939297" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/banner"
            android:layout_width="564dp"
            android:layout_height="633dp"
            android:layout_marginStart="20dp"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:src="@drawable/login_banner_teamwork"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/guideColumn"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/authOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>